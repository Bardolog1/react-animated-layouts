{
  "name": "react-animated-layouts",
  "version": "0.1.0",
  "description": "Customizable animated layout components for React.",
  "license": "MIT",
  "author": "Libardo Lozano",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "site:dev": "vite site",
    "site:build": "vite build site",
    "site:preview": "vite preview site",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "keywords": [
    "react",
    "layout",
    "animation",
    "svg",
    "waves",
    "aurora",
    "gradient",
    "blob",
    "particles",
    "contours",
    "dunes"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.2",
    "typescript": "^5.6.0",
    "vite": "^8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bardolog1/react-animated-layouts.git"
  },
  "homepage": "https://bardolog1.github.io/react-animated-layouts/",
  "bugs": {
    "url": "https://github.com/Bardolog1/react-animated-layouts/issues"
  }
}
