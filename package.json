{
  "name": "react-animated-layouts",
  "version": "0.1.0",
  "description": "Customizable animated layout components for React.",
  "license": "MIT",
  "author": "Libardo Lozano",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "keywords": [
    "react",
    "layout",
    "animation",
    "svg",
    "waves",
    "aurora",
    "gradient"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.2",
    "typescript": "^5.6.0",
    "vite": "^8.3.4"
  }
}
